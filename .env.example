# Arc / Circle
ARC_RPC_URL=https://rpc.arc.io
ARC_CHAIN_ID=1234
ARC_PRIVATE_KEY=0x...
CIRCLE_API_KEY=...
CIRCLE_ENTITY_SECRET=...

# Contract addresses (filled after deploy)
USDC_ADDRESS=
PROVIDER_REGISTRY_ADDRESS=
COMMIT_REVEAL_ADDRESS=
SIGNAL_MARKET_ADDRESS=
ZK_VERIFIER_ADDRESS=

# Circle Wallet (buyer agent)
CIRCLE_WALLET_ID=               # programmable wallet ID from Circle console
CIRCLE_USDC_TOKEN_ID=           # USDC token ID on Arc from Circle console
CIRCLE_USYC_TOKEN_ID=           # USYC token ID (optional, for yield parking)

# Arc token addresses (for trade execution)
ARC_ETH_ADDRESS=                # ETH contract address on Arc
ARC_BTC_ADDRESS=                # BTC/WBTC contract address on Arc
ARC_SHORT_VAULT_ADDRESS=        # Short vault address (or same as asset address for testnet)
USYC_CONTRACT_ADDRESS=          # USYC mint address on Arc (for yield parking)

# Agent keys
PROVIDER_AGENT_PRIVATE_KEY=0x...
PROVIDER_AGENT_PUBLIC_KEY=...   # corresponding public key (hex)
BUYER_AGENT_PRIVATE_KEY=0x...
BUYER_ADDRESS=0x...             # the human buyer's wallet address

# Signal encryption (NaCl box keypairs — generate with agents/shared/crypto.py)
PROVIDER_SIGNING_KEY=...        # provider agent NaCl privkey hex
PROVIDER_NACL_PUBKEY=...        # provider agent NaCl pubkey hex
BUYER_AGENT_NACL_PRIVKEY=...    # buyer agent NaCl privkey hex
BUYER_AGENT_NACL_PUBKEY=...     # buyer agent NaCl pubkey hex (registered on subscribe)

# ZK proof tuning
ZK_PROOF_EVERY_N_SIGNALS=10     # submit proof on-chain every N reveals

# Backend
DATABASE_URL=sqlite:///./zkroute.db
API_SECRET_KEY=...
BACKEND_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_ARC_CHAIN_ID=1234
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.arc.io
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_PROVIDER_REGISTRY_ADDRESS=
NEXT_PUBLIC_SIGNAL_MARKET_ADDRESS=
NEXT_PUBLIC_COMMIT_REVEAL_ADDRESS=

# x402 Nanopayments
X402_FACILITATOR_URL=https://facilitator.arc.io
SIGNAL_PRICE_USDC=0.01

# Pyth oracle
PYTH_ENDPOINT=https://hermes.pyth.network

# Agent timing (lower for demos)
SIGNAL_INTERVAL_SECONDS=14400   # 4h default, set to 60 for demo
REVEAL_DELAY_SECONDS=300        # 5m default, set to 30 for demo
